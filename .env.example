# Environment Variables Configuration
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000
DATABASE_URL="postgresql://nexus_admin:nexus_secure_password_2026@localhost:5432/nexus_db?schema=public"

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=nexus_redis_secret

# JWT Secrets
JWT_SECRET=nexus_super_jwt_secret_key_change_in_production_2026
JWT_REFRESH_SECRET=nexus_super_refresh_jwt_secret_key_2026

# MinIO / S3 Object Storage
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=nexus-media
S3_PUBLIC_URL=http://localhost:9000/nexus-media
S3_ACCESS_KEY=nexus_minio_user
S3_SECRET_KEY=nexus_minio_password_2026

# WebRTC STUN/TURN (Optional defaults)
TURN_URL=turn:localhost:3478
TURN_USERNAME=nexus
TURN_CREDENTIAL=nexus_turn_secret

# Web client API base URL
NEXT_PUBLIC_API_URL=http://localhost:4000
